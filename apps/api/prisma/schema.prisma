// Prisma schema — Chi Tiêu Gia Đình
// PostgreSQL cho MỌI môi trường (Phase 1):
// - Dev/test/e2e: Postgres local qua `docker-compose.dev.yml` (root repo)
// - Prod: Supabase (Vercel) hoặc self-host Docker — xem docs/deploy*.md
// Không dùng enum của Prisma → role dùng String + const phía code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime (app) — nếu qua pooler transaction mode (Supabase :6543) phải có query param `?pgbouncer=true` ở CUỐI URL
  directUrl = env("DIRECT_URL")   // Prisma CLI (migrate, db push) — = url khi không có pooler
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships FamilyMember[]
  expenses    Expense[]
}

model Family {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members        FamilyMember[]
  categories     Category[]
  expenses       Expense[]
  rentalConfig   RentalConfig?
  rentalMonths   RentalMonth[]
  recurringRules RecurringRule[]
}

model FamilyMember {
  id       String   @id @default(cuid())
  familyId String
  userId   String
  role     String   @default("MEMBER") // "OWNER" | "MEMBER"
  joinedAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
}

model Category {
  id       String  @id @default(cuid())
  familyId String
  name     String
  icon     String
  isPreset Boolean @default(false)
  order    Int     @default(0)
  // Gợi ý ghi chú nhanh: JSON array string (≤8 mục, mỗi mục 1–30 ký tự) — null = không có.
  noteSuggestions String?

  family         Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  recurringRules RecurringRule[]

  @@unique([familyId, name])
}

model Expense {
  id         String   @id @default(cuid())
  familyId   String
  userId     String // người nhập khoản chi
  categoryId String
  amount     Int // số nguyên VND
  date       String // YYYY-MM-DD (ngày cục bộ)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])
  category Category    @relation(fields: [categoryId], references: [id])
  // Khoản chi do "chốt tháng phòng trọ" tạo ra (RentalMonth.expenseId) —
  // có link = KHÔNG sửa/xoá được từ endpoint expenses thường (409).
  rentalMonth RentalMonth?
  // Khoản chi do rule định kỳ sinh ra (spec: docs/spec-recurring.md) — sửa/xoá
  // được như khoản thường; xoá rule → link rỗng (SetNull), khoản giữ lại.
  // Unique (recurringRuleId, date) = idempotency khi materialize (NULL không
  // xung đột — khoản nhập tay nhiều cùng ngày vẫn được).
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([familyId, categoryId, date])
  @@unique([recurringRuleId, date])
}

// Tiền phòng trọ hàng tháng (spec: docs/spec-rental.md)
//
// RentalConfig  — thông tin mặc định 1 lần/family (4 khoản cố định + 2 đơn giá),
//                 tháng mới tạo ra tự kế thừa (snapshot), sửa được theo tháng.
// RentalMonth   — 1 dòng = 1 tháng, snapshot đầy đủ để lưu lịch sử; chốt (CONFIRMED)
//                 → tạo/cập nhật 1 Expense liên kết qua expenseId (1-1).

model RentalConfig {
  id              String   @id @default(cuid())
  familyId        String   @unique
  rent            Int      @default(0) // Tiền phòng (đ)
  internet        Int      @default(0) // Tiền mạng (đ)
  elevator        Int      @default(0) // Thang máy + vệ sinh (đ)
  parking         Int      @default(0) // Gửi xe (đ)
  electricityRate Int      @default(0) // Giá điện (đ/kWh)
  waterRate       Int      @default(0) // Giá nước (đ/m³)
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model RentalMonth {
  id              String   @id @default(cuid())
  familyId        String
  month           String // "YYYY-MM"
  rent            Int
  internet        Int
  elevator        Int
  parking         Int
  oldElec         Int // số công tơ điện đầu kỳ (int kWh — số chỉ dồn tích)
  newElec         Int
  electricityRate Int
  oldWater        Int // số công tơ nước đầu kỳ (int m³)
  newWater        Int
  waterRate       Int
  status          String   @default("DRAFT") // "DRAFT" | "CONFIRMED"
  expenseId       String?  @unique // Expense liên kết khi chốt
  confirmedAt     DateTime?
  updatedAt       DateTime @updatedAt

  family  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([familyId, month])
  @@index([familyId])
}

// Giao dịch định kỳ — lặp hàng tháng (spec: docs/spec-recurring.md)
//
// Rule do OWNER setup 1 lần (tiền + danh mục + ghi chú + ngày "Từ" + điều kiện
// kết thúc). Hệ thống "materialize" (sinh Expense) theo chuỗi kỳ neo ngày
// "Từ" — lazy khi FE gọi endpoint materialize (không có cron phía server).
//
// - nextDate     = con trỏ kỳ kế tiếp cần sinh; null = rule hết vòng đời.
// - generatedCount = số kỳ ĐÃ sinh (đếm theo kỳ, KHÔNG giảm khi xoá khoản).
// - frequency    = cố định "MONTHLY" ở MVP (user chốt 01/10) — cột dự phòng
//                  để mở rộng tần suất khác (additive) mà không phá schema.
// - khoản sinh ra (Expense.recurringRuleId) sửa/xoá được như khoản thường;
//   xoá rule → SetNull, khoản giữ lại như khoản thường.

model RecurringRule {
  id              String   @id @default(cuid())
  familyId        String
  userId          String // người tạo (luôn OWNER)
  categoryId      String
  amount          Int // số nguyên VND — cap như Expense.amount
  note            String? // ghi chú kế thừa xuống mọi khoản sinh ra
  frequency       String   @default("MONTHLY") // MVP chỉ "MONTHLY"
  startDate       String // "Từ" — YYYY-MM-DD; NGÀY của nó = anchor chuỗi kỳ
  endType         String // "FOREVER" | "UNTIL_DATE" | "COUNT"
  endDate         String? // endType = UNTIL_DATE
  occurrenceCount Int? // endType = COUNT
  nextDate        String? // kỳ kế tiếp cần sinh — null = hoàn tất
  generatedCount  Int      @default(0)
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses Expense[]

  @@index([familyId, nextDate])
}
