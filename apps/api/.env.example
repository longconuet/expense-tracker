# Copy thành .env rồi chỉnh nếu cần.
# PostgreSQL local — BẮT BUỘC chạy trước: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://etracker:etracker@localhost:5432/expense_tracker"
# Cho Prisma CLI (migrate, db push) — trùng DATABASE_URL khi không dùng connection pooler
DIRECT_URL="postgresql://etracker:etracker@localhost:5432/expense_tracker"
#JWT_SECRET: chuỗi ngẫu nhiên dài (VD: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="doi-toi-chuoi-ngau-50-ki-tu"
