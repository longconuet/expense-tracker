{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @expense-tracker/api exec prisma generate",
    "dev": "pnpm --filter @expense-tracker/shared build && concurrently -n shared,api,web -c yellow,blue,green \"pnpm --filter @expense-tracker/shared dev\" \"pnpm --filter @expense-tracker/api dev\" \"pnpm --filter @expense-tracker/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm --filter @expense-tracker/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @expense-tracker/shared build && pnpm --filter @expense-tracker/web e2e",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
